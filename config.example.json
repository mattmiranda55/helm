{
  "server": {
    "host": "127.0.0.1",
    "port": 3001,
    "allowedOrigins": []
  },
  "auth": {
    "token": null
  },
  "terminal": {
    "enabled": true,
    "shell": null,
    "args": [],
    "cwd": null
  },
  "refreshMs": 5000,
  "nodes": [
    {
      "id": "server",
      "label": "Server",
      "url": "http://localhost:61208",
      "api": 4
    }
  ],
  "commands": [
    {
      "name": "docker ps",
      "description": "List running containers",
      "command": "docker ps --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}'"
    },
    {
      "name": "reboot",
      "description": "Reboot this machine",
      "command": "sudo systemctl reboot"
    }
  ],
  "services": [
    {
      "group": "Infrastructure",
      "name": "Glances",
      "url": "http://localhost:61208",
      "description": "System metrics API",
      "container": "glances",
      "node": "server"
    },
    {
      "group": "Media",
      "name": "Jellyfin",
      "url": "http://localhost:8096",
      "description": "Media server",
      "container": "jellyfin",
      "node": "server",
      "favorite": true
    },
    {
      "group": "Apps",
      "name": "Notes",
      "url": "https://notes.example.com",
      "description": "Self-hosted notes"
    }
  ],
  "alerts": {
    "enabled": false,
    "url": "https://ntfy.example.com",
    "topic": "helm-alerts",
    "token": null,
    "clickUrl": "http://localhost:3001/",
    "intervalMs": 60000,
    "sustain": 3,
    "repeatMs": 0,
    "notifyRecovery": true,
    "rules": {
      "cpu": null,
      "mem": null,
      "swap": null,
      "loadPerCore": null,
      "fs": 90,
      "temperature": true,
      "containerCrashed": true,
      "nodeDown": true
    },
    "tokenFile": "/home/you/.config/ntfy-token"
  },
  "stacks": {
    "enabled": true,
    "dir": "/opt/stacks",
    "command": null,
    "template": null,
    "envTemplate": null
  }
}
