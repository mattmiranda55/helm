{
  "name": "helm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash -c 'trap \"kill 0\" EXIT; bun run --hot server/index.ts & vite'",
    "dev:server": "bun run --hot server/index.ts",
    "dev:web": "vite",
    "build": "vue-tsc && vite build",
    "start": "bun run server/index.ts",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ionicons": "^8.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "description": "Homelab dashboard — Glances metrics + a root terminal, served over your tailnet"
}
